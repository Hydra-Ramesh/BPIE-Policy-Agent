# ==============================================================================
# BPIE AI POLICY AGENT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in your root directory and/or backend directory
# ==============================================================================

# Flask Server Configuration
PORT=5000
SECRET_KEY=bpie-super-secure-production-secret-key-change-this-2026
JWT_SECRET_KEY=bpie-jwt-token-secret-key-production-change-this-2026

# ------------------------------------------------------------------------------
# 1. Neon PostgreSQL Database Configuration
# Obtain your free Postgres URL from Neon console: https://console.neon.tech
# Format: postgresql://<user>:<password>@<neon-endpoint>.neon.tech/<dbname>?sslmode=require
# If left empty, the application falls back gracefully to local SQLite (sqlite:///bpie_policy.db)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Groq Free API Key (Required for LLM and Whisper STT)
# Get a 100% free API key from https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 3. Qdrant Vector Database
# Option A (Recommended for Cloud): Create a free cluster at https://cloud.qdrant.io
# Option B (Local fallback): Leave QDRANT_URL blank and it will use local disk storage in backend/qdrant_storage
# ------------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-url.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=bpie_college_policies

# ------------------------------------------------------------------------------
# 4. Free Embedding & Reranker Models (Zero Cost, CPU-optimized)
# FastEmbed model for 384-dim dense embeddings:
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# FlashRank model for production cross-encoder reranking:
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# ------------------------------------------------------------------------------
# 5. College Domain Security & RBAC Configuration
# Restricts registration strictly to students and staff with @bpie.ac.in emails
# ------------------------------------------------------------------------------
ALLOWED_EMAIL_DOMAIN=@bpie.ac.in
ADMIN_EMAILS=admin@bpie.ac.in,principal@bpie.ac.in,director@bpie.ac.in

# ------------------------------------------------------------------------------
# 6. Streamlit Frontend Configuration
# URL where your Flask backend is hosted (Render URL or localhost)
# ------------------------------------------------------------------------------
BACKEND_URL=http://localhost:5000
